# OpenStreetMap discovery does not require an API key.
# ElevenLabs Voice Technology (server-side only; never put in frontend code)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_AGENT_ID=
# Browser Use Cloud (server-side only)
BROWSER_USE_API_KEY=
# Agent 37 Cloud Platform (server-side only)
AGENT37_API_KEY=
# Optional SQLite path; for Render persistent disk use /var/data/carenexus.db
# DB_PATH=/var/data/carenexus.db
# Server port (defaults to 3000)
# PORT=3000
